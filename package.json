{
  "name": "kuri0515-lang",
  "private": true,
  "type": "module",
  "description": "韓語／日語單字卡 —— 前端為純靜態，npm 僅用於跑測試",
  "scripts": {
    "test": "npm run test:sites && npm run test:build && npm run test:lang && npm run test:boot && npm run test:arch && npm run test:arch:ja && npm run test:round && npm run test:session && npm run test:modes && npm run test:modes:ja && npm run test:card && npm run test:card:ja && npm run test:matrix && npm run test:matrix:ja && npm run test:flow && npm run test:flow:ja && npm run test:overlay && npm run test:overlay:ja && npm run test:script && npm run test:script:ja && npm run test:dom && npm run test:dom:ja",
    "test:lang": "node tests/lang.test.mjs",
    "test:arch": "node tests/arch.test.mjs",
    "test:arch:ja": "SITE=japanese node tests/arch.test.mjs",
    "test:session": "node tests/session.test.mjs",
    "test:modes": "node tests/modes.test.mjs tests/fixtures/pool.json",
    "test:dom": "node tests/dom.test.mjs tests/fixtures/pool.json",
    "serve": "python3 -m http.server 8000",
    "backup": "python3 shared/scripts/backup.py",
    "backup:ja": "SITE=japanese python3 shared/scripts/backup.py",
    "audit": "python3 shared/scripts/audit_content.py",
    "audit:ja": "SITE=japanese python3 shared/scripts/audit_content.py",
    "test:boot": "node tests/boot.test.mjs",
    "test:modes:ja": "SITE=japanese node tests/modes.test.mjs tests/fixtures/pool-ja.json",
    "test:dom:ja": "SITE=japanese node tests/dom.test.mjs tests/fixtures/pool-ja.json",
    "build:sites": "node shared/scripts/build-sites.mjs",
    "test:sites": "node shared/scripts/build-sites.mjs --check",
    "test:card": "STUB_POOL=tests/fixtures/pool.json node --import ./tests/_cdn-stub.mjs tests/card.test.mjs tests/fixtures/pool.json",
    "test:card:ja": "SITE=japanese STUB_POOL=tests/fixtures/pool-ja.json node --import ./tests/_cdn-stub.mjs tests/card.test.mjs tests/fixtures/pool-ja.json",
    "test:matrix": "node --import ./tests/_cdn-stub.mjs tests/matrix.test.mjs",
    "test:matrix:ja": "SITE=japanese node --import ./tests/_cdn-stub.mjs tests/matrix.test.mjs",
    "test:flow": "node --import ./tests/_cdn-stub.mjs tests/flow.test.mjs tests/fixtures/pool.json",
    "test:flow:ja": "SITE=japanese node --import ./tests/_cdn-stub.mjs tests/flow.test.mjs tests/fixtures/pool-ja.json",
    "test:round": "node tests/round.test.mjs",
    "test:build": "node tests/build.test.mjs",
    "build:vendor": "node shared/scripts/build-vendor.mjs",
    "test:overlay": "node tests/overlay.test.mjs",
    "test:overlay:ja": "SITE=japanese node tests/overlay.test.mjs",
    "test:script": "node --import ./tests/_script-stub.mjs tests/script.test.mjs",
    "test:script:ja": "SITE=japanese node --import ./tests/_script-stub.mjs tests/script.test.mjs",
    "audit:spy": "python3 japanese/scripts/audit_script.py --deck-slug spy-s1",
    "audit:spy:self": "python3 japanese/scripts/audit_script.py --self-test"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.0"
  }
}
