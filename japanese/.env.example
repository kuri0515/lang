# 日文站專用。複製為 .env.local（已被 .gitignore 擋住），填入真實值。
# ⚠️ 必須是「日文站自己的」Supabase 專案 —— 填成韓文站的會寫壞她的學習記錄。
# Supabase Dashboard → Settings → API

SUPABASE_URL=
SUPABASE_ANON_KEY=

# service_role key 只用于本地导入脚本，绝不写进任何前端文件、绝不 commit
SUPABASE_SERVICE_ROLE_KEY=

# 資料庫密碼（Settings → Database）。scripts/migrate.sh 用它直連跑 migration。
SUPABASE_DB_PASSWORD=
