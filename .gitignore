# === 密钥：第一个 commit 就必须挡住 ===
.env
.env.*
!.env.example
config.local.js
*.key
secrets/

# 依赖 / 构建
node_modules/
dist/
.cache/

# 原始素材（体积大，不进 git）。拆 monorepo 後 raw/ 在各站底下，
# 所以規則要帶 **/ —— 少了它，korean/raw/ 會整包被 commit 進去
**/raw/*
!**/raw/.gitkeep
!**/raw/README.md

# 系统
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# npm（前端不需要建置，node_modules 僅測試用）
node_modules/
package-lock.json

# 備份含個人學習記錄，不進 git
backups/
